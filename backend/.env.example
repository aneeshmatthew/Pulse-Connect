# ── Required ─────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (Vercel serverless functions cannot
# reach a local `mongodb://localhost` instance — use Atlas or another
# hosted MongoDB).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulseconnect?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# ── Recommended ──────────────────────────────────────────────────────────
NODE_ENV=production

# Comma-separated list of allowed frontend origin(s) for CORS, e.g. your
# Vercel frontend project's URL(s). No trailing slash.
FRONTEND_URL=https://your-frontend.vercel.app

# ── Media uploads (Cloudinary) ───────────────────────────────────────────
# From your Cloudinary Console dashboard (cloudinary.com/console) — the
# Cloud Name, API Key, and API Secret are shown right at the top.
# CLOUDINARY_API_SECRET must NEVER be exposed to the frontend; it's only
# used server-side to sign upload requests. Without these three set, the
# Photo/Video composer button will show an error instead of crashing the
# rest of the app.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Local dev only ───────────────────────────────────────────────────────
# PORT=4000
